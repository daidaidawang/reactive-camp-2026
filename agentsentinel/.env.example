# Copy selected values into .env; never overwrite an existing .env blindly.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
LASNA_RPC=https://lasna-rpc.rnk.dev
# Fill from NEW deployment receipts. Old deployment addresses are incompatible.
EXECUTOR_ADDR=
SENTINEL_ADDR=
CALLBACK_ADDR=
MERCHANT_ADDR=
CALLBACK_PROXY_ADDR=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4
MINIMUM_BOND_WEI=10000000000000000
TOTAL_SPEND_LIMIT_WEI=100000000000000000
REACTIVE_FUNDING_WEI=100000000000000000
CALLBACK_FUNDING_WEI=10000000000000000
# Source executor deployment block, required by worker.
FROM_BLOCK=
CONFIRMATIONS=12
POLL_INTERVAL_MS=15000
# Optional, explanation only. With no key the output is labelled rules.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# Required only with --submit. Do not put a raw private key here.
CAST_ACCOUNT=
CAST_PASSWORD_FILE=
